{
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python .codex/hooks/user_prompt_guard.py",
          "command_windows": "python .codex\\hooks\\user_prompt_guard.py"
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "*",
