          "command_windows": "python .codex\\hooks\\pre_tool_guard.py"
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python .codex/hooks/stop_check.py",
          "command_windows": "python .codex\\hooks\\stop_check.py"
        }
      ]
    }
  ]
}
